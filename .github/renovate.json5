{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  suppressNotifications: ["prEditedNotification"],
  minimumReleaseAge: "7 days",
  extends: [
    "config:recommended",
    "github>munich-quantum-toolkit/templates//renovate/cmake",
    ":gitSignOff",
    "helpers:pinGitHubActionDigestsToSemver",
    ":automergeDigest",
    ":combinePatchMinorReleases",
    ":configMigration",
    ":enablePreCommit",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
  ],
  enabledManagers: [
    "cargo",
    "custom.regex",
    "github-actions",
    "npm",
    "pep621",
    "pep723",
    "pip_requirements",
    "pre-commit",
  ],
  pep723: {
    managerFilePatterns: ["/\\.py$/"],
  },
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  labels: ["dependencies"],
  // Saturday and Sunday (UTC).
  schedule: ["* * * * 0,6"],
  packageRules: [
    {
      matchManagers: ["cargo"],
      addLabels: ["rust"],
      commitMessagePrefix: "⬆\uFE0F\uD83E\uDD80",
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["github-actions"],
      commitMessagePrefix: "⬆\uFE0F\uD83D\uDC68\u200D\uD83D\uDCBB",
    },
    {
      matchManagers: ["npm"],
      addLabels: ["javascript"],
      commitMessagePrefix: "⬆\uFE0F\uD83D\uDCDC",
    },
    {
      matchManagers: ["pep621", "pep723", "pip_requirements"],
      addLabels: ["python"],
      commitMessagePrefix: "⬆\uFE0F\uD83D\uDC0D",
    },
    {
      matchManagers: ["pre-commit"],
      addLabels: ["pre-commit"],
      commitMessagePrefix: "⬆\uFE0F\uD83E\uDE9D",
      versioning: "pep440",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      commitMessagePrefix: "⬆\uFE0F\uD83D\uDD12\uFE0F",
    },
    {
      description: "Group and auto-merge patch updates outside 0.0.x",
      groupName: "patch updates",
      matchUpdateTypes: ["patch"],
      matchCurrentVersion: "!/^[vV]?0[.]0/",
      commitMessagePrefix: "⬆\uFE0F\uD83E\uDE79",
      automerge: true,
    },
    {
      description: "Group and auto-merge minor updates of stable dependencies",
      groupName: "minor stable updates",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^[vV]?0[.]/",
      matchPackageNames: [
        "!munich-quantum-toolkit/*",
        "!munich-quantum-software/*",
        "!nanobind",
      ],
      commitMessagePrefix: "⬆\uFE0F\uD83E\uDE79",
      automerge: true,
    },
    {
      description: "Disable minimum release age checks for our own GitHub actions",
      matchManagers: ["github-actions"],
      matchPackageNames: [
        "munich-quantum-toolkit/*",
        "munich-quantum-software/*",
      ],
      minimumReleaseAge: null,
    },
    {
      description: "Disable minimum release age checks for our own Python packages",
      matchDatasources: ["pypi"],
      matchPackageNames: ["mqt*"],
      minimumReleaseAge: null,
    },
    {
      description: "Review FetchContent updates individually",
      matchManagers: ["custom.regex"],
      matchFileNames: ["cmake/ExternalDependencies.cmake"],
      groupName: null,
      automerge: false,
    },
  ],
}
